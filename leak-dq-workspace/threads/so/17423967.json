   "body_html": "You mix your endianess, little endian have the lowest by in the lowest memory location."
  },
  {
   "post_type": "comment",
   "post_id": 25307293,
   "parent_id": 17424129,
   "parent_type": "answer",
   "author_user_id": 20270,
   "author_display_name": "Hasturkun",
