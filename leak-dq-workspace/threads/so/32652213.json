   "score": 25,
   "created_utc": "2015-09-18T12:57:57Z",
   "edited": false,
   "license": "CC BY-SA 3.0",
   "body_html": "So the return type of malloc was <b>char</b> and not <b>void</b>. Thank you."
  },
