   "last_activity_utc": "2011-06-20T03:04:35Z",
   "license": "CC BY-SA 3.0",
   "body_html": "<p>You can use <a href=\"http://www.sgi.com/tech/stl/copy.html\" rel=\"nofollow\">std::copy</a> and <a href=\"http://www.sgi.com/tech/stl/ostream_iterator.html\" rel=\"nofollow\">std::ostream_iterator</a>.</p>\n"
  },
