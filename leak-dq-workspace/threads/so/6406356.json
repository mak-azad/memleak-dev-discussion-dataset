   "edited": false,
   "license": "CC BY-SA 3.0",
   "body_html": "Sorry, what do v and X represent?"
  },
  {
   "post_type": "comment",
   "post_id": 7512386,
   "parent_id": 6406393,
   "parent_type": "answer",
   "author_user_id": 78845,
   "author_display_name": "johnsyweb",
   "author_id_missing": false,
   "role": "responder",
   "is_accepted": null,
   "permalink": "https://stackoverflow.com/questions/6406356/#comment7512386_6406393",
   "score": 0,
   "created_utc": "2011-06-20T02:53:13Z",
   "edited": false,
   "license": "CC BY-SA 3.0",
   "body_html": "<code>v</code> is your containing vector. <code>X</code> is the type contained therein."
  },
  {
