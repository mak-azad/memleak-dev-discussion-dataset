 "permalink": "https://stackoverflow.com/questions/9098890/how-to-check-for-memory-leaks-in-jni",
 "body_html": "<p>In my JNI program, I use</p>\n\n<pre><code>new\ndelete\nenv-&gt;NewGlobalRef\nenv-&gt;DeleteGlobalRef\njvm-&gt;AttachCurrentThread\njvm-&gt;DetachCurrentThread\n</code></pre>\n\n<p>What is a good way to check for memory leaks rigorously?</p>\n",
 "passes": [
  "offcwe"
 ],
 "data_source": "so_offcwe (refetch with full paging)",
 "in_main_retained_480": false,
 "in_main_nonNA_coded_346": false,
 "in_offcwe_nonNA_coded": true,
 "events": [
